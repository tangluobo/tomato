        </Button>
        <Button 
                style="-fx-background-color: transparent; -fx-pref-width: 40px; -fx-pref-height: 40px; -fx-background-radius: 8px;">
          <graphic>
            <SVGPath content="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.37-.3-.59-.22l-2.49 1c-.52-.39-1.08-.7-1.66-.94l-.38-2.65c-.03-.24-.24-.42-.48-.42h-4c-.24 0-.45.18-.48.42l-.38 2.65c-.58.24-1.14.55-1.66.94l-2.49-1c-.22-.08-.47 0-.59.22l-2 3.46c-.12.22-.07.49.12.64l2.11 1.65c-.04.32-.07.64-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.37.3.59.22l2.49-1c.52.39 1.08.7 1.66.94l.38 2.65c.03.24.24.42.48.42h4c.24 0 .45-.18.48-.42l.38-2.65c.58-.24 1.14-.55 1.66-.94l2.49 1c.22.08.47 0 .59-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zm-7.43 2.52c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" 
                     fill="WHITE" stroke="WHITE" strokeWidth="1.5"/>
          </graphic>
        </Button>
        <Button 
                style="-fx-background-color: transparent; -fx-pref-width: 40px; -fx-pref-height: 40px; -fx-background-radius: 8px;">
          <graphic>
            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                     fill="WHITE" stroke="WHITE" strokeWidth="1.5"/>
          </graphic>
        </Button>
      </children>
    </VBox>
    
    <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #ffffff;" HBox.hgrow="ALWAYS">
      <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
      </padding>
      <children>
        <Label fx:id="welcomeText"/>
        <Button text="Hello!" onAction="#onHelloButtonClick"/>
      </children>
    </VBox>
  </children>
</HBox>