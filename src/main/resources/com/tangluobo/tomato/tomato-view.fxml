<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.Region?>

<HBox fx:id="rootPane" spacing="0.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tangluobo.tomato.TomatoController">
  <children>
    <VBox fx:id="navPane" prefWidth="62.0" style="-fx-background-color: #ececea; -fx-border-color: #e5e5e5; -fx-border-width: 0 1 0 0;" spacing="10.0">
      <padding>
        <Insets bottom="20.0" left="10.0" right="10.0" top="20.0"/>
      </padding>
      <children>
        <Button onAction="#onModuleClick" 
                style="-fx-background-color: transparent; -fx-pref-width: 40px; -fx-pref-height: 40px; -fx-background-radius: 8px;"
                userData="connect">
          <graphic>
            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-.121.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" 
                     fill="WHITE" stroke="WHITE" strokeWidth="1.5"/>
          </graphic>
        </Button>
        <Button onAction="#onModuleClick" 
                style="-fx-background-color: transparent; -fx-pref-width: 45px; -fx-pref-height: 45px; -fx-background-radius: 8px;"
                userData="tools">
          <graphic>
            <SVGPath content="M19.43 12.98c.04-.32.07-.64.07-.98s-.03-.66-.07-.98l2.11-1.65c.19-.15.24-.42.12-.64l-2-3.46c-.12-.22-.37-.3-.59-.22l-2.49 1c-.52-.39-1.08-.7-1.66-.94l-.38-2.65c-.03-.24-.24-.42-.48-.42h-4c-.24 0-.45.18-.48.42l-.38 2.65c-.58.24-1.14.55-1.66.94l-2.49-1c-.22-.08-.47 0-.59.22l-2 3.46c-.12.22-.07.49.12.64l2.11 1.65c-.04.32-.07.64-.07.98s.03.66.07.98l-2.11 1.65c-.19.15-.24.42-.12.64l2 3.46c.12.22.37.3.59.22l2.49-1c.52.39 1.08.7 1.66.94l.38 2.65c.03.24.24.42.48.42h4c.24 0 .45-.18.48-.42l.38-2.65c.58-.24 1.14-.55 1.66-.94l2.49 1c.22.08.47 0 .59-.22l2-3.46c.12-.22.07-.49-.12-.64l-2.11-1.65zm-7.43 2.52c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z" 
                     fill="WHITE" stroke="WHITE" strokeWidth="1.5"/>
          </graphic>
        </Button>
        <Button onAction="#onModuleClick" 
                style="-fx-background-color: transparent; -fx-pref-width: 40px; -fx-pref-height: 40px; -fx-background-radius: 8px;"
                userData="settings">
          <graphic>
            <SVGPath content="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z" 
                     fill="WHITE" stroke="WHITE" strokeWidth="1.5"/>
          </graphic>
        </Button>
      </children>
    </VBox>
    
    <VBox fx:id="sidebarPane" prefWidth="240.0" style="-fx-background-color: #ffffff;" HBox.hgrow="NEVER"/>
    
    <Region fx:id="divider2" style="-fx-background-color: linear-gradient(to right, transparent 3.5px, #D9D9D7 3.5px, #D9D9D7 4.5px, transparent 4.5px);" prefWidth="1.0"/>
    
    <VBox fx:id="contentPane" style="-fx-background-color: #f7f7f7;" HBox.hgrow="ALWAYS">
      <children>
        <HBox fx:id="titleBar" style="-fx-background-color: #ffffff; -fx-border-color: #D9D9D7; -fx-border-width: 0 0 1 0;" prefHeight="52" minHeight="52" maxHeight="52" spacing="10">
          <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/>
          </padding>
          <children>
            <Label fx:id="chatTitle" text="选择一个模块"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="minimizeBtn" style="-fx-background-color: transparent; -fx-pref-width: 24px; -fx-pref-height: 24px;"
                    onAction="#onMinimize">
              <graphic>
                <SVGPath content="M6 14h12v-2H6v2z" fill="#cccccc"/>
              </graphic>
            </Button>
            <Button fx:id="maximizeBtn" style="-fx-background-color: transparent; -fx-pref-width: 24px; -fx-pref-height: 24px;"
                    onAction="#onMaximize">
              <graphic>
                <SVGPath content="M3 3h18v18H3V3zm2 2v14h14V5H5z" fill="#e5e5e5"/>
              </graphic>
            </Button>
            <Button fx:id="closeBtn" style="-fx-background-color: transparent; -fx-pref-width: 24px; -fx-pref-height: 24px;"
                    onAction="#onClose">
              <graphic>
                <SVGPath content="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z" fill="#ff5f56"/>
              </graphic>
            </Button>
          </children>
        </HBox>
        
        <ScrollPane fx:id="chatScrollPane" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
          <content>
            <VBox fx:id="chatContent" spacing="10">
              <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
              </padding>
            </VBox>
          </content>
        </ScrollPane>
      </children>
    </VBox>
  </children>
</HBox>