            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>${mainClass}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>assemble-all</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.1</version>
                <executions>
                    <execution>
                        <id>java-agent</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <phase>test</phase>
                        <configuration>
                            <skip>${agent.exec.skip}</skip>
                            <executable>java</executable>
                            <workingDirectory>${project.build.directory}</workingDirectory>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>${mainClass}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jpackage</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${jpackage.skip}</skip>
                            <executable>${java.home}/bin/jpackage</executable>
                            <environmentVariables>
                                <WIX>${jpackage.wixdir}</WIX>
                                <PATH>${jpackage.wixdir}${path.separator}${env.PATH}</PATH>
                            </environmentVariables>
                            <commandlineArgs>--type ${jpackage.type} --name ${project.name} --dest "${project.basedir}/dist" --input "${project.build.directory}/jpackage-input" --main-jar ${project.build.finalName}-jar-with-dependencies.jar --main-class ${mainClass} --app-version ${jpackage.app.version} --vendor tangluobo --description "Tomato database and server connection tool" ${jpackage.platform.args}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.graalvm.buildtools</groupId>
                <artifactId>native-maven-plugin</artifactId>
                <version>${native.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <imageName>${project.artifactId}</imageName>
                    <mainClass>${mainClass}</mainClass>
                    <!-- 与 exec-maven-plugin 中负责启动可交互应用的 execution id 保持一致。 -->
                    <agent>
                        <enabled>${native.agent.enabled}</enabled>
                        <metadataCopy>
                            <!-- 交互采集只合并 main；测试阶段的 agent 输出不污染应用配置。 -->
                            <disabledStages>
                                <stage>test</stage>
                            </disabledStages>
                            <outputDirectory>${project.basedir}/src/main/resources/META-INF/native-image</outputDirectory>
                            <merge>true</merge>
                        </metadataCopy>
                    </agent>
                    <buildArgs>
                        <buildArg>--enable-native-access=ALL-UNNAMED</buildArg>
                        <buildArg>--no-fallback</buildArg>
                        <buildArg>-H:+AddAllCharsets</buildArg>
                        <buildArg>-H:-CheckToolchain</buildArg>
                        <!-- Netty 在构建期创建 SLF4J JUL 适配器。 -->
                        <buildArg>--initialize-at-build-time=org.slf4j.jul.JDK14LoggerAdapter</buildArg>
                        <buildArg>--initialize-at-run-time=io.netty.channel.kqueue.Native,io.netty.channel.kqueue.KQueueEventArray</buildArg>
                        <!-- Woodstox/MinIO 的工厂与配置必须延迟到运行期初始化。 -->
                        <buildArg>--initialize-at-run-time=com.ctc.wstx.stax.WstxInputFactory,com.ctc.wstx.stax.WstxOutputFactory,com.ctc.wstx.stax.WstxEventFactory,com.ctc.wstx.api.ReaderConfig,com.ctc.wstx.api.WriterConfig</buildArg>
                    </buildArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>stage-jpackage-input</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <skip>${jpackage.skip}</skip>
                            <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>${project.build.finalName}-jar-with-dependencies.jar</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>archive-native-image</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <skip>${native.archive.skip}</skip>
                            <target>
                                <delete dir="${native.stage.root}"/>
                                <mkdir dir="${native.stage.dir}"/>
                                <mkdir dir="${project.basedir}/dist"/>
                                <copy file="${project.build.directory}/${native.executable.name}"
                                      todir="${native.stage.dir}" failonerror="true"/>
                                <copy todir="${native.stage.dir}" failonerror="false">
                                    <fileset dir="${project.build.directory}">
                                        <include name="*.dll"/>
                                        <include name="*.so"/>
                                        <include name="*.so.*"/>
                                        <include name="*.dylib"/>
                                        <include name="*.dylib.*"/>
                                    </fileset>
                                </copy>
                                <copy file="${project.basedir}/README.md" todir="${native.stage.dir}"/>
                                <copy file="${project.basedir}/LICENSE" todir="${native.stage.dir}"/>
                                <chmod file="${native.stage.dir}/${native.executable.name}"
                                       perm="755" osfamily="unix"/>
                                <zip destfile="${project.basedir}/dist/${native.bundle.name}.zip">
                                    <zipfileset dir="${native.stage.dir}" prefix="${native.bundle.name}"
                                                filemode="644">
                                        <exclude name="${native.executable.name}"/>
                                    </zipfileset>
                                    <zipfileset dir="${native.stage.dir}" prefix="${native.bundle.name}"
                                                filemode="755">
                                        <include name="${native.executable.name}"/>
                                    </zipfileset>
                                </zip>
                                <tar destfile="${project.basedir}/dist/${native.bundle.name}.tar.gz"
                                     compression="gzip" longfile="gnu">
                                    <tarfileset dir="${native.stage.dir}" prefix="${native.bundle.name}"
                                                filemode="644">
                                        <exclude name="${native.executable.name}"/>
                                    </tarfileset>
                                    <tarfileset dir="${native.stage.dir}" prefix="${native.bundle.name}"
                                                filemode="755">
                                        <include name="${native.executable.name}"/>
                                    </tarfileset>
                                </tar>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>windows-native-gui</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <configuration>
                            <buildArgs combine.children="append">
                                <!-- 使用 Windows GUI 子系统，启动 AOT 可执行文件时不创建控制台窗口。 -->
                                <buildArg>-H:NativeLinkerOption=/SUBSYSTEM:WINDOWS</buildArg>
                                <buildArg>-H:NativeLinkerOption=/ENTRY:mainCRTStartup</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-platform-windows</id>
            <activation>
                <os>
                    <family>Windows</family>
                </os>
            </activation>
            <properties>
                <native.package.os>windows</native.package.os>
                <native.executable.name>tomato.exe</native.executable.name>
            </properties>
        </profile>
        <profile>
            <id>native-platform-linux</id>
            <activation>
                <os>
                    <name>Linux</name>
                </os>
