<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tangluobo</groupId>
    <artifactId>tomato</artifactId>
    <version>1.0.2</version>
    <name>tomato</name>

    <properties>
        <maven.compiler.source>24</maven.compiler.source>
        <maven.compiler.target>24</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <native.maven.plugin.version>0.11.3</native.maven.plugin.version>
        <mainClass>com.tangluobo.tomato.Launcher</mainClass>
        <javafx.version>27-ea+24</javafx.version>
        <!-- jpackage 相关属性 -->
        <!-- 默认 package 只构建普通 JAR，不启动 UI，也不启用 Native Image tracing agent。 -->
        <agent.exec.skip>true</agent.exec.skip>
        <native.agent.enabled>false</native.agent.enabled>
        <!-- jpackage 打包类型：exe（Win 安装向导，需 WiX 3.x）/ rpm（Linux）/ msi / app-image（绿色目录） -->
        <jpackage.type>exe</jpackage.type>
        <!-- 所有平台的应用版本和产物文件名均从 POM 项目版本自动获取。 -->
        <jpackage.app.version>${project.version}</jpackage.app.version>
        <!-- WiX 3.x binaries 目录（jpackage 生成 exe/msi 时查找 candle.exe/light.exe），
             指向项目内置的 packaging/wix314；也可用 WIX 环境变量或 PATH 覆盖 -->
        <jpackage.wixdir>${project.basedir}/packaging/wix314</jpackage.wixdir>
        <!-- 平台相关 jpackage 参数串（图标 + 安装向导选项），由 os-activated profile 自动注入 -->
        <jpackage.platform.args></jpackage.platform.args>
        <!-- 默认构建不执行 jpackage；发布 Profile 会覆盖为 false。 -->
        <jpackage.skip>true</jpackage.skip>
        <jpackage.archive.skip>true</jpackage.archive.skip>
        <jpackage.archive.format>zip</jpackage.archive.format>
        <jpackage.output.name>tomato-${os.name}-${os.arch}</jpackage.output.name>
        <!-- Native Image 完成后自动整理运行文件并生成 ZIP 与 tar.gz。 -->
        <native.archive.skip>true</native.archive.skip>
        <native.package.os>unknown</native.package.os>
        <native.package.arch>unknown</native.package.arch>
        <native.executable.name>tomato</native.executable.name>
        <native.bundle.name>${project.artifactId}-${project.version}-${native.package.os}-${native.package.arch}</native.bundle.name>
        <native.stage.root>${project.build.directory}/native-package</native.stage.root>
        <native.stage.dir>${native.stage.root}/${native.bundle.name}</native.stage.dir>
    </properties>

    <description>
        Tomato JavaFX application. The default Maven lifecycle builds regular JAR artifacts.
        Optional Maven profiles collect and merge GraalVM tracing-agent metadata or build a
        platform-native executable on Windows, Linux, and macOS.
    </description>

